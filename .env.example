# --- Router (run once, keep running) ---

TELEGRAM_BOT_TOKEN=

# LLM provider for smart agent switching (pick one)
# ROUTER_MODEL=anthropic:claude-haiku-4-5-20251001
# ROUTER_MODEL=openai:gpt-5.4-nano
# ROUTER_MODEL=google:gemini-3.1-flash-lite-preview

# API key for your chosen provider (uncomment the one you need)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...

# If ROUTER_MODEL is not set but ANTHROPIC_API_KEY is, defaults to anthropic:claude-haiku-4-5-20251001
# If no model and no key are set, LLM routing is disabled (fuzzy match only)

# ROUTER_PORT=9900
# ROUTER_HOST=127.0.0.1          # set to 0.0.0.0 to allow remote bridge connections
# ALLOWED_USER_IDS=               # comma-separated Telegram user IDs

# --- Bridge (per Claude Code session, usually auto-configured) ---

# ROUTER_URL=ws://127.0.0.1:9900/ws   # point to remote router if not on localhost
