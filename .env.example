# --- Router (run once, keep running) ---
# Configure one or both platforms. Agent replies go to all connected platforms.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=               # auto-detected on first run

# --- Discord ---
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=               # your Discord server ID
# DISCORD_CATEGORY=Claude Agents  # category name for agent channels

# --- Shared ---
# ROUTER_PORT=9900
# ROUTER_HOST=127.0.0.1          # set to 0.0.0.0 to allow remote bridge connections
# ALLOWED_USER_IDS=               # comma-separated user IDs

# --- Bridge (per Claude Code session, usually auto-configured) ---
# ROUTER_URL=ws://127.0.0.1:9900/ws   # point to remote router if not on localhost
